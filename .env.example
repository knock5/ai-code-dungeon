# ============================================================
# AI Code Dungeon — Environment Variables
# ============================================================
# Salin nilai API Key dari: Makers → Models → API Key
# (yang dimulai dengan sk-...)

# API Key dari tab "Models → API Key" di EdgeOne Makers console
MAKERS_MODELS_KEY=YOUR_API_KEY_HERE

# Model yang digunakan (dari EdgeOne Makers Models)
# Format: @makers/<nama-model>
# Contoh: @makers/deepseek-v4-flash, @makers/gpt-4o-mini
AI_MODEL=YOUR_MODEL_NAME_HERE
